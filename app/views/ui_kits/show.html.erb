<%= render "shared/breadcrumbs", ui_kit: @ui_kit, current_page: "ui_kit" %>
<div class="container my-5">

  <% if @components_by_category.any? %>
    <div class="kit-anchor-nav">
      <% @components_by_category.keys.each do |category| %>
        <a href="#category-<%= (category.presence || "other").parameterize %>">
          <%= (category.presence || "Other").capitalize %>
        </a>
      <% end %>
    </div>
  <% end %>

  <div class="d-flex gap-4">
    <div class="components-list flex-grow-1">
      <% @components_by_category.each do |category, components| %>
        <section id="category-<%= (category.presence || "other").parameterize %>" class="kit-category-section">
          <% components.each do |component| %>
            <%= render "components/card", component: component %>
          <% end %>
        </section>
      <% end %>
    </div>
    <div data-controller="toggle" id="add-component-button">
      <button
    type="button"
    class="btn btn-primary rounded-circle"
    data-action="click->toggle#toggle">
        <i
      class="fa-solid fa-plus"
      data-toggle-target="icon">
        </i>
      </button>
      <div class="message-box p-4 rounded d-none" data-toggle-target="content">
        <p class="pb-3 border-bottom">Kitly Copilot</p>
        <% @ui_kit.messages.each do |message| %>
          <%= render "messages/message", message: message %>
        <% end %>
        <%= simple_form_for [@ui_kit, @message] do |f| %>
          <div class="d-flex">
            <%= f.input :content,
              label: false,
              placeholder: "Describe the component you'd like to create...",
              class: "flex-grow-1 w-100",
              input_html: { class: "message-textarea" } %>
            <%= button_tag type: "submit",
              class: "btn btn-primary rounded-circle submit-btn" do %>
              <i class="fa-solid fa-arrow-up-long"></i>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
