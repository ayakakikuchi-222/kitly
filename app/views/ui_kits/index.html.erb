<div class="ui-kits-index container" data-controller="kit-creation">
  <h1 class="mb-4">My UI Kits</h1>
  <div class="row row-cols-1 row-cols-md-3 g-4">
    <div class="col">
      <button type="button"
              class="btn border rounded d-flex flex-column align-items-center justify-content-center w-100 h-100"
              data-bs-toggle="offcanvas"
              data-bs-target="#newUiKitPanel"
              aria-controls="newUiKitPanel">
        <span class="fs-1">+</span>
        <span>New Kit</span>
      </button>
    </div>


    <% @ui_kits.each do |ui_kit| %>
      <div class="col">
        <div class="card h-100">
          <%= button_to ui_kit_path(ui_kit),
                method: :delete,
                form: { class: "position-absolute top-0 end-0 m-2", data: { turbo_confirm: "Are you sure you want to delete this UI Kit?" } },
                class: "btn btn-sm btn-icon-delete" do %>
            <i class="fa-solid fa-xmark icon-x"></i>
            <i class="fa-solid fa-trash icon-trash"></i>
          <% end %>

          <% if (img = ui_kit_image(ui_kit)) %>
            <%= image_tag img, class: "card-img-top kit-thumb", alt: ui_kit.name %>
          <% end %>

          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= link_to ui_kit.name, ui_kit_path(ui_kit) %></h5>
            <p class="card-text text-truncate"><%= ui_kit.description %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="offcanvas offcanvas-end" tabindex="-1" id="newUiKitPanel" aria-labelledby="newUiKitPanelLabel">
    <div class="offcanvas-header">
      <h5 class="offcanvas-title" id="newUiKitPanelLabel">New UI Kit</h5>
      <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
      <%= simple_form_for(@ui_kit, html: { data: { action: "turbo:submit-start->kit-creation#show turbo:submit-end->kit-creation#hide" } }) do |f| %>
        <%= f.error_notification %>
        <div class="mb-3">
          <%= label_tag :theme_prompt, "What kind of website are you creating?", class: "form-label" %>
          <%= text_area_tag :theme_prompt, nil, class: "form-control", required: true, placeholder: "e.g. a cozy artisan bakery with warm, rustic tones" %>
        </div>
        <%= f.button :submit, data: { turbo_submits_with: "Creating your kit..." } %>
      <% end %>
    </div>
  </div>

  <div class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-75 flex-column align-items-center justify-content-center d-none"
       style="z-index: 1080;"
       data-kit-creation-target="overlay">
    <div class="spinner-border text-light mb-3" style="width: 3rem; height: 3rem;" role="status">
      <span class="visually-hidden">Loading...</span>
    </div>
    <p class="text-white fs-5 mb-0">Generating your UI kit...</p>
  </div>
</div>
