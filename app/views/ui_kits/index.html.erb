<div class="kitly-home">
  <h1>My UI Kits</h1>

  <%= link_to "New UI Kit", ui_kits_path %>


  <% if @ui_kits.any? %>
    <ul>
      <% @ui_kits.each do |ui_kit| %>
        <li>
          <%= link_to ui_kit.name, ui_kit_path(ui_kit) %> - <%= ui_kit.description %>
        </li>
      <%= button_to "Delete", ui_kit_path(ui_kit), method: :delete, form: { data: { turbo_confirm: "Are you sure?" } } %>
      <% end %>
    </ul>
  <% else %>
    <p>No kits yet — time to make your first one!</p>
  <% end %>
</div>
