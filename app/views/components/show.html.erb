<div class="component-show-layout d-flex gap-4">
  <div class="component-main flex-grow-1">
    <%= link_to "← Back to UI Kit", ui_kit_path(@component.ui_kit) %>

    <h1 class="mt-3"><%= @component.category %></h1>

    <div class="box-preview-codes d-flex mt-4">
      <div class="preview w-50 d-flex justify-content-center align-items-center">
        <style>
          <%= @component.css_code %>
        </style>
        <% if @component.html_code.present? %>
          <%= @component.html_code.html_safe %>
        <% end %>
      </div>

      <div class="codes w-50">
        <div class="card m-3 p-3">
          <ul class="nav tabs-underlined" id="myTab" role="tablist">
            <li class="nav-item" role="presentation">
              <span class="nav-link tab-underlined active" id="html-tab" data-bs-toggle="tab" data-bs-target="#html-tab-pane" role="tab" aria-controls="html-tab-pane" aria-selected="true">HTML</span>
            </li>
            <li class="nav-item" role="presentation">
              <span class="nav-link tab-underlined" id="css-tab" data-bs-toggle="tab" data-bs-target="#css-tab-pane" role="tab" aria-controls="css-tab-pane" aria-selected="false">CSS</span>
            </li>
          </ul>
          <div class="tab-content" id="myTabContent">
            <div class="tab-pane fade py-3 show active" id="html-tab-pane" role="tabpanel" aria-labelledby="html-tab" tabindex="0">
              <code><pre><%= @component.html_code %></pre></code>
            </div>
            <div class="tab-pane fade py-3" id="css-tab-pane" role="tabpanel" aria-labelledby="css-tab" tabindex="0">
              <code><pre><%= @component.css_code %></pre></code>
            </div>
          </div>
        </div>
      </div>
    </div>

    <hr class="my-5">

    <h2>Edit Component</h2>
    <%= simple_form_for(@component) do |f| %>
      <%= f.error_notification %>
      <%= f.input :category %>
      <%= f.input :html_code, as: :text, input_html: { rows: 10 } %>
      <%= f.input :css_code, as: :text, input_html: { rows: 10 } %>
      <%= f.button :submit, "Save changes", class: "btn btn-primary" %>
    <% end %>

    <%= button_to "Delete Component", component_path(@component),
          method: :delete,
          form: { data: { turbo_confirm: "Are you sure you want to delete this component? This cannot be undone." } },
          class: "btn btn-outline-danger mt-3" %>
  </div>
</div>
