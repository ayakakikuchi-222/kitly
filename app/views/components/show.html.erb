<div class="container d-flex gap-5 my-5 justify-content-between">
  <div class="component-show-layout gap-4 w-100">
    <div id="card">
      <%= render "components/card", component: @component %>
    </div>
    <div>
      <hr class="my-5">
      <h2>Edit Component</h2>
      <%= simple_form_for(@component) do |f| %>
        <%= f.error_notification %>
        <%= f.input :category %>
        <%= f.input :html_code, as: :text, input_html: { rows: 10 } %>
        <%= f.input :css_code, as: :text, input_html: { rows: 10 } %>
        <%= f.button :submit, "Save changes", class: "btn btn-primary" %>
      <% end %>
      <%= button_to "Delete Component", component_path(@component),
          method: :delete,
          form: { data: { turbo_confirm: "Are you sure you want to delete this component? This cannot be undone." } },
          class: "btn btn-outline-danger mt-3" %>
    </div>
  </div>
  <div class="message-box p-4 rounded">
    <p class="pb-3 border-bottom">Kitly Copilot</p>
    <div id="messages">
      <%= render 'messages/messages', messages: @component.messages.order(:created_at) %>
    </div>
    <div id="new_message">
      <%= render "messages/form", component: @component, message: @message %>
    </div>
  </div>
</div>
