<style>
  @import url('https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&display=swap');

  .kitly-home {
    background: #d6ecf0;
    font-family: 'Baloo 2', sans-serif;
    min-height: 100vh;
    padding: 24px 5vw 80px;
  }
  .kitly-nav { display: flex; align-items: center; justify-content: space-between; }
  .kitly-logo { display: flex; align-items: center; gap: 12px; font-weight: 800; font-size: 28px; color: #d94a5e; text-decoration: none; }
  .kitly-logo-dot { width: 44px; height: 44px; border-radius: 50%; background: #d94a5e; box-shadow: 0 5px 0 #b23548; display: flex; align-items: center; justify-content: center; }
  .kitly-logo-dot::after { content: ""; width: 16px; height: 16px; border-radius: 50%; background: #f7d3da; }
  .kitly-nav-links { display: flex; gap: 32px; align-items: center; }
  .kitly-nav-links a { color: #6d1c29; font-weight: 700; text-decoration: none; font-size: 18px; }
  .btn-kitly { display: inline-block; border: none; border-radius: 999px; padding: 14px 32px; font-family: inherit; font-weight: 700; font-size: 18px; text-decoration: none; cursor: pointer; }
  .btn-cherry { background: #d94a5e; color: white; box-shadow: 0 6px 0 #b23548; }
  .btn-berry { background: #6d1c29; color: white; box-shadow: 0 6px 0 #4aononono1119; }
  .btn-white { background: white; color: #6d1c29; box-shadow: 0 6px 0 #f2c6cf; }
  .btn-kitly:hover { transform: translateY(2px); box-shadow-color: none; color: white; }
  .btn-white:hover { color: #6d1c29; }

  .kitly-hero { text-align: center; margin-top: 70px; }
  .kitly-badge { display: inline-block; background: white; color: #d94a5e; font-weight: 700; font-size: 17px; padding: 10px 26px; border-radius: 999px; box-shadow: 0 5px 0 #f2c6cf; }
  .kitly-hero h1 { font-size: clamp(48px, 8vw, 96px); font-weight: 800; color: #6d1c29; margin: 28px 0 20px; line-height: 1.05; }
  .kitly-hero p {
    font-size: 21px;
    line-height: 1.6;        /* ← space between the two lines: try 1.3 (tight) to 2 (airy) */
    margin: 24px auto 0;     /* ← first number = top margin, keeps space above the text */
    color: #6d1c29;
    font-weight: 600;
    max-width: 52ch;
  }
  .kitly-cta-row { display: flex; gap: 18px; justify-content: center; margin-top: 40px; flex-wrap: wrap; }
  .kitly-chips { display: flex; gap: 16px; justify-content: center; margin-top: 56px; flex-wrap: wrap; }
  .kitly-chip { background: white; color: #6d1c29; font-weight: 700; font-size: 17px; padding: 12px 28px; border-radius: 999px; box-shadow: 0 5px 0 #f2c6cf; }
